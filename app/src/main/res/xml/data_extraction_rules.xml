<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Local encrypted tokens bound to Android Keystore should stay device-only. -->
        <exclude domain="sharedpref" path="github_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

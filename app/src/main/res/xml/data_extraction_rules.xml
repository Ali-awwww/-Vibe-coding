<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Supabase session ciphertext is bound to the local Android Keystore key. -->
        <exclude domain="sharedpref" path="supabase_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer an encrypted session without its non-exportable Keystore key. -->
        <exclude domain="sharedpref" path="supabase_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>

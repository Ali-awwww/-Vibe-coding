rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // 1. GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isEpochMillis(value) {
      return value is int && value > 0;
    }
    function isEpochOrServerTime(value) {
      return isEpochMillis(value) || (value is timestamp && value <= request.time);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // 2. USER PROFILES
    // ---------------------------------------------------------
    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.email is string && data.email.size() >= 1 && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('organization' in data) || (data.organization is string && data.organization.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidUser(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'organization', 'photoUrl', 'updatedAt']);
    }

    // ---------------------------------------------------------
    // 3. PROJECTS & SUBRESOURCES
    // ---------------------------------------------------------
    function isValidProject(data, userId, projectId) {
      return data.id == projectId &&
             isValidId(data.id) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             data.ownerId == userId &&
             data.dataRetentionDays is int && data.dataRetentionDays >= 1 && data.dataRetentionDays <= 3650 &&
             data.piiScrubbingEnabled is bool &&
             isEpochMillis(data.createdAt);
    }

    function isValidApplication(data, userId, projectId, applicationId) {
      return data.id == applicationId &&
             isValidId(data.id) &&
             data.projectId == projectId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('platform' in data) || (data.platform is string && data.platform.size() <= 50)) &&
             (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 200)) &&
             data.ownerId == userId &&
             isEpochMillis(data.createdAt);
    }

    function isValidCrash(data, userId, projectId, crashId) {
      return data.id == crashId &&
             isValidId(data.id) &&
             data.projectId == projectId &&
             data.applicationId is string && data.applicationId.size() >= 1 && data.applicationId.size() <= 128 &&
             data.exceptionType is string && data.exceptionType.size() >= 1 && data.exceptionType.size() <= 200 &&
             data.userId == userId &&
             data.isResolved is bool &&
             isEpochMillis(data.timestamp);
    }

    function isValidIssue(data, userId, projectId, issueId) {
      return data.id == issueId &&
             isValidId(data.id) &&
             data.projectId == projectId &&
             data.ownerId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.fingerprint is string && data.fingerprint.size() >= 1 && data.fingerprint.size() <= 256 &&
             data.status is string &&
             isEpochMillis(data.firstSeen) &&
             isEpochMillis(data.lastOccurrence);
    }

    function isValidDiagnosis(data, crashId) {
      return data.crashId == crashId &&
             isValidId(data.crashId) &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 5000 &&
             data.rootCause is string && data.rootCause.size() >= 1 && data.rootCause.size() <= 5000 &&
             data.certainty is string &&
             isEpochMillis(data.createdAt);
    }

    function isValidFixSuggestion(data, fixId) {
      return data.id == fixId &&
             isValidId(data.id) &&
             data.crashId is string && isValidId(data.crashId) &&
             data.suggestedCode is string && data.suggestedCode.size() >= 1 && data.suggestedCode.size() <= 100000 &&
             data.explanation is string && data.explanation.size() <= 10000 &&
             data.status is string &&
             isEpochMillis(data.createdAt);
    }

    function isValidIntegration(data, projectId, integrationId) {
      return data.id == integrationId &&
             isValidId(data.id) &&
             data.projectId == projectId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.type is string &&
             isEpochMillis(data.createdAt);
    }

    function isValidProjectMember(data, projectId) {
      return data.projectId == projectId &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.role is string &&
             isEpochMillis(data.addedAt);
    }

    match /users/{userId}/projects/{projectId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming(), userId, projectId);
      allow update: if isOwner(userId) && isValidProject(incoming(), userId, projectId) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'dataRetentionDays', 'piiScrubbingEnabled']);
      allow delete: if isOwner(userId);

      match /applications/{applicationId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(applicationId) && isValidApplication(incoming(), userId, projectId, applicationId);
        allow update: if isOwner(userId) && isValidApplication(incoming(), userId, projectId, applicationId) &&
                         incoming().id == existing().id &&
                         incoming().projectId == existing().projectId &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /crashes/{crashId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(crashId) && isValidCrash(incoming(), userId, projectId, crashId);
        allow update: if isOwner(userId) && isValidCrash(incoming(), userId, projectId, crashId) &&
                         incoming().id == existing().id &&
                         incoming().projectId == existing().projectId &&
                         incoming().applicationId == existing().applicationId &&
                         incoming().userId == existing().userId &&
                         incoming().timestamp == existing().timestamp;
        allow delete: if isOwner(userId);
      }

      match /issues/{issueId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(issueId) && isValidIssue(incoming(), userId, projectId, issueId);
        allow update: if isOwner(userId) && isValidIssue(incoming(), userId, projectId, issueId) &&
                         incoming().id == existing().id &&
                         incoming().projectId == existing().projectId &&
                         incoming().ownerId == existing().ownerId &&
                         incoming().firstSeen == existing().firstSeen;
        allow delete: if isOwner(userId);
      }

      match /diagnoses/{crashId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(crashId) && isValidDiagnosis(incoming(), crashId);
        allow update: if isOwner(userId) && isValidDiagnosis(incoming(), crashId) &&
                         incoming().crashId == existing().crashId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /fix_suggestions/{fixId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(fixId) && isValidFixSuggestion(incoming(), fixId);
        allow update: if isOwner(userId) && isValidFixSuggestion(incoming(), fixId) &&
                         incoming().id == existing().id &&
                         incoming().crashId == existing().crashId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /integrations/{integrationId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(integrationId) && isValidIntegration(incoming(), projectId, integrationId);
        allow update: if isOwner(userId) && isValidIntegration(incoming(), projectId, integrationId) &&
                         incoming().id == existing().id &&
                         incoming().projectId == existing().projectId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /members/{memberId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(memberId) && isValidProjectMember(incoming(), projectId);
        allow update: if isOwner(userId) && isValidProjectMember(incoming(), projectId) &&
                         incoming().projectId == existing().projectId &&
                         incoming().userId == existing().userId &&
                         incoming().addedAt == existing().addedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['role', 'displayName', 'userEmail']);
        allow delete: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------
    // 4. AUDIT LOGS & NOTIFICATIONS
    // ---------------------------------------------------------
    function isValidAuditLog(data, userId, logId) {
      return data.id == logId &&
             isValidId(data.id) &&
             data.userId == userId &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000)) &&
             isEpochOrServerTime(data.timestamp);
    }

    match /users/{userId}/audit_logs/{logId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(logId) && isValidAuditLog(incoming(), userId, logId);
    }

    function isValidNotification(data, notificationId) {
      return data.id == notificationId &&
             isValidId(data.id) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.isRead is bool &&
             isEpochMillis(data.timestamp);
    }

    match /users/{userId}/notifications/{notificationId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming(), notificationId);
      allow update: if isOwner(userId) && isValidNotification(incoming(), notificationId) &&
                       incoming().id == existing().id &&
                       incoming().timestamp == existing().timestamp &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // 5. AI PROVIDERS (BYOK)
    // ---------------------------------------------------------
    function isValidAIProvider(data, userId, providerId) {
      return data.id == providerId &&
             isValidId(data.id) &&
             data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.type is string &&
             isEpochMillis(data.createdAt);
    }

    match /users/{userId}/ai_providers/{providerId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(providerId) && isValidAIProvider(incoming(), userId, providerId);
      allow update: if isOwner(userId) && isValidAIProvider(incoming(), userId, providerId) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // 6. MODEL TEAMS, EXECUTIONS & USAGE RECORDS
    // ---------------------------------------------------------
    function isValidModelTeam(data, userId, teamId) {
      return data.id == teamId &&
             isValidId(data.id) &&
             data.ownerId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             isEpochMillis(data.createdAt) &&
             isEpochMillis(data.updatedAt);
    }

    function isValidTeamExecution(data, userId, executionId) {
      return data.id == executionId &&
             isValidId(data.id) &&
             data.teamId is string && data.teamId.size() >= 1 && data.teamId.size() <= 128 &&
             data.userId == userId &&
             data.prompt is string && data.prompt.size() <= 20000 &&
             data.status is string &&
             isEpochMillis(data.startedAt);
    }

    function isValidTeamUsageRecord(data, userId, recordId) {
      return data.id == recordId &&
             isValidId(data.id) &&
             data.userId == userId &&
             data.teamId is string && data.teamId.size() >= 1 && data.teamId.size() <= 128 &&
             data.modelId is string &&
             isEpochMillis(data.timestamp);
    }

    match /users/{userId}/model_teams/{teamId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(teamId) && isValidModelTeam(incoming(), userId, teamId);
      allow update: if isOwner(userId) && isValidModelTeam(incoming(), userId, teamId) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/team_executions/{executionId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(executionId) && isValidTeamExecution(incoming(), userId, executionId);
      allow update: if isOwner(userId) && isValidTeamExecution(incoming(), userId, executionId) &&
                       incoming().id == existing().id &&
                       incoming().teamId == existing().teamId &&
                       incoming().userId == existing().userId &&
                       incoming().startedAt == existing().startedAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/team_usage_records/{recordId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(recordId) && isValidTeamUsageRecord(incoming(), userId, recordId);
      allow update: if isOwner(userId) && isValidTeamUsageRecord(incoming(), userId, recordId) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().teamId == existing().teamId &&
                       incoming().timestamp == existing().timestamp;
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // 7. COLLECTION GROUP READS (SCOPED BY OWNER/USER FIELD)
    // ---------------------------------------------------------
    match /{path=**}/applications/{applicationId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{path=**}/crashes/{crashId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/issues/{issueId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
